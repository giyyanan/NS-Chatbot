# Copy to `.env` (gitignored) and fill in to opt into Ollama Cloud when
# running via `docker compose up`. Leave both unset/commented to run fully
# offline against the local qwen2.5:7b model -- no signup or key needed,
# and this is what `docker compose up` does out of the box.

# Ollama Cloud API key (https://ollama.com -> Settings -> API keys). Lets
# the `ollama` container authenticate non-interactively, since the usual
# `ollama signin` device-code flow can't run inside a headless container.
# OLLAMA_API_KEY=

# Chat model backend/agent_network/faq_chatbot.hocon resolves at runtime.
# Set to gpt-oss:20b-cloud (its default) or another Ollama Cloud model
# together with OLLAMA_API_KEY above to use Ollama Cloud instead of the
# local qwen2.5:7b fallback.
# OLLAMA_MODEL=gpt-oss:20b-cloud
