# Copy to `.env` (gitignored) and fill in. All variables below are optional
# -- leave them empty to run fully offline against the local qwen2.5:7b
# model, no signup or key needed (this is what `docker compose up` does by
# default).

# Ollama Cloud API key (https://ollama.com -> Settings -> API keys).
# Auto-read by the `ollama` client itself for Bearer auth -- not read
# directly by any code here.
OLLAMA_API_KEY=

# Chat LLM base_url -- backend/agent_network/faq_chatbot.hocon. Point this
# at https://ollama.com (with OLLAMA_API_KEY above) to use Ollama Cloud
# instead of a local `ollama serve` daemon.
OLLAMA_BASE_URL=

# Chat model name -- backend/agent_network/faq_chatbot.hocon. Must have a
# catalog entry in backend/agent_network/faq_llm_info.hocon (Ollama models
# aren't in neuro-san's built-in catalog). Defaults to gpt-oss:120b-cloud.
OLLAMA_MODEL=

# Embeddings client host -- backend/coded_tools/faq_index.py. Leave unset;
# embeddinggemma isn't a cloud model, this should stay pointed at a local
# Ollama daemon (defaults to http://127.0.0.1:11434).
OLLAMA_EMBED_HOST=

# Number of FAQ matches faq_search returns -- backend/coded_tools/faq_retriever.py.
# Defaults to 10.
RETRIEVAL_TOP_K=
