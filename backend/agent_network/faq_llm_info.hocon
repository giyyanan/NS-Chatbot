# Registers the Ollama model used by faq_chatbot.hocon.
# neuro-san requires every llm_config.model_name to have a catalog entry;
# this model isn't in the built-in default_llm_info.hocon.
{
    "gpt-oss:20b-cloud": {
        "class": "ollama",
        "model_info_url": "https://ollama.com/library/gpt-oss",
        "modalities": {
            "input": [ "text" ],
            "output": [ "text" ],
        },
        "capabilities": [ "tools" ],
        "context_window_size": 131072,
        "max_output_tokens": 32768,
        "knowledge_cutoff": "unknown",
    },

    "gpt-oss:120b-cloud": {
        "class": "ollama",
        "model_info_url": "https://ollama.com/library/gpt-oss",
        "modalities": {
            "input": [ "text" ],
            "output": [ "text" ],
        },
        "capabilities": [ "tools" ],
        "context_window_size": 131072,
        "max_output_tokens": 32768,
        "knowledge_cutoff": "unknown",
    },

    # Local (non-cloud) fallback -- no `ollama signin` or API key needed,
    # just `ollama pull qwen2.5:7b`.
    "qwen2.5:7b": {
        "class": "ollama",
        "model_info_url": "https://ollama.com/library/qwen2.5",
        "modalities": {
            "input": [ "text" ],
            "output": [ "text" ],
        },
        "capabilities": [ "tools" ],
        "context_window_size": 32768,
        "max_output_tokens": 8192,
        "knowledge_cutoff": "unknown",
    },
}
